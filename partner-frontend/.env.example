# ---- QuickPress frontend environment (development) ----
# FastAPI backend base URL. Leave empty to run the app on local fixtures/mocks.
VITE_API_BASE_URL=
# Request timeout in milliseconds (default 15000).
VITE_API_TIMEOUT_MS=15000
# development | staging | production
VITE_APP_ENV=development

# ---- Firebase Authentication (never hardcode these in source) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Apple Sign In is prepared but must stay "false" on Android builds.
VITE_APPLE_SIGN_IN_ENABLED=false

# ---- Google Maps (browser rendering key only; server key lives in FastAPI) ----
VITE_GOOGLE_MAPS_API_KEY=
