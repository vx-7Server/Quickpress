# ---- QuickPress FastAPI backend environment ----
# Variable NAMES only. Never commit real secret values.

# development | staging | production
APP_ENV=development
API_PREFIX=/api

# Comma separated list of allowed frontend origins (required in production).
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084

# ---- MongoDB Atlas ----
# mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# Required in production. Empty only runs the local in-memory preview store.
MONGODB_URI=
MONGODB_DB_NAME=quickpress

# ---- JWT ----
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ---- Firebase Admin (service account) ----
FIREBASE_PROJECT_ID=quickpress-b1e19
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively provide the whole service account:
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Google Maps Platform ----
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=
DELIVERY_RADIUS_KM=8

# ---- OTP ----
OTP_TTL_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
